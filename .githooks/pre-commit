#!/bin/sh
# Naked Compound — pre-commit hook
# Automatically rebuilds sitemap.xml before every commit.
#
# Install once:  git config core.hooksPath .githooks
# After that:    runs automatically on every `git commit`

echo "→ Updating sitemap.xml..."
node scripts/update-sitemap.js

# Stage the updated sitemap so it's included in this commit
git add project/sitemap.xml

# Rebuild the machine-readable LLM index from the fresh sitemap
if [ -f scripts/update-llms.js ]; then
  echo "→ Updating llms-full.txt..."
  node scripts/update-llms.js
  git add project/llms-full.txt
fi

echo ""

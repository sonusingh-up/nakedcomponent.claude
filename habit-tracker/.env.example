# Supabase — copy this file to .env and fill in your project values.
# Find these in your Supabase dashboard: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# Server-only service role key (used by server/api routes that bypass RLS).
# NEVER expose this to the client. Leave unset until you add server routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
